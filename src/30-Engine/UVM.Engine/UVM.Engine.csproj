<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup Label="Project_Information">
        <Authors>Alexandre DA CUNHA</Authors>
        <Company>TBD</Company>
    </PropertyGroup>

    <PropertyGroup Label="Package_Information">
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Configurations>Release;Debug</Configurations>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <PropertyGroup Label="Package_Information">
        <IsPackable>true</IsPackable>
        <PackageId>UVM.Engine</PackageId>
        <Version>$(UVMVersion)</Version>
        <Description>A package containing tools for tree computation, upgrading, dumping, and packaging.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup Label="ThirdParty_Dependencies"></ItemGroup>

    <ItemGroup Label="Release_Dependencies" Condition="'$(Configuration)' == 'Release'">
        <PackageReference Include="UVM.Logging" />
    </ItemGroup>

    <ItemGroup Label="Debug_Dependencies" Condition="'$(Configuration)' == 'Debug'">
        <ProjectReference Include="..\..\10-Common\UVM.Interface\UVM.Interface.csproj" />
        <ProjectReference Include="..\..\10-Common\UVM.Logging\UVM.Logging.csproj" />
    </ItemGroup>

    <ItemGroup Label="Misc">
        <None Include="docs/README.md" Pack="true" PackagePath="/" />
        
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>UVM.Engine.Test</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>